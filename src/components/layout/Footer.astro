---
import { getConfig } from '@lib/config';
import { loadProfileContent } from '@lib/content';
import SocialIcon from '@components/ui/SocialIcon.astro';

const config = getConfig();
const profile = loadProfileContent();
const year = new Date().getFullYear();

function isExternalLink(href: string): boolean {
  return href.startsWith('http');
}
---

<footer class="mt-16">
  <div class="section-divider"></div>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div>
        <p class="text-sm font-semibold tracking-[-0.02em] text-[var(--color-text)]">Roger Baiges</p>
        <p class="mt-2 max-w-2xl text-sm text-[var(--color-text-secondary)]">{config.profile.bio_short}</p>
      </div>

      <div class="flex flex-wrap items-center gap-2 md:gap-3">
        {profile.contact.links.map(link => (
          <a
            href={link.href}
            target={isExternalLink(link.href) ? '_blank' : undefined}
            rel={isExternalLink(link.href) ? 'noopener noreferrer' : undefined}
            class="footer-link"
            aria-label={`${link.label}: ${link.value}`}
          >
            <span class="footer-link-mark" aria-hidden="true">
              <SocialIcon kind={link.label} class="h-3.5 w-3.5" />
            </span>
            <span>{link.label}</span>
          </a>
        ))}
      </div>
    </div>

    <p class="mt-6 text-xs text-[var(--color-text-secondary)]">
      © {year} Roger Baiges. Built on Astro with a customized Lumina base.
    </p>
  </div>
</footer>

<style>
  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.8rem;
    border-radius: 999px;
    border: 1px solid transparent;
    color: var(--color-text-secondary);
    transition: color var(--transition-base), border-color var(--transition-base), background-color var(--transition-base), transform var(--transition-base);
  }

  .footer-link:hover {
    color: var(--color-text);
    border-color: color-mix(in srgb, var(--color-accent) 24%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 6%, var(--color-card-bg));
    box-shadow: var(--shadow-sm);
    transform: translateY(-1.5px);
    text-decoration: none;
  }

  .footer-link-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.45rem;
    height: 1.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
    transition: background-color var(--transition-base), transform var(--transition-base);
  }

  .footer-link:hover .footer-link-mark {
    background: color-mix(in srgb, var(--color-accent) 15%, transparent);
    transform: translateY(-0.5px);
  }
</style>
