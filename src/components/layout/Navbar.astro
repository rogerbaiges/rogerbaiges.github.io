---
import { getConfig, getEnabledPages } from '@lib/config';
import ThemeToggle from '../ui/ThemeToggle.astro';

const config = getConfig();
const pages = getEnabledPages();
const currentPath = Astro.url.pathname;
---

<nav class="glass sticky top-0 z-50 border-b border-[var(--color-border)]/80" transition:animate="none">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between gap-6">
      <a href="/" class="nav-brand text-[1.02rem] font-semibold tracking-[-0.02em] text-[var(--color-text)]">
        {config.site.title}
      </a>

      <div class="hidden md:flex items-center gap-1.5">
        {pages.map(page => (
          <a
            href={page.path}
            class:list={[
              'nav-link px-3 py-2 rounded-lg text-sm',
              currentPath === page.path || (page.path !== '/' && currentPath.startsWith(page.path))
                ? 'text-[var(--color-accent)] bg-[var(--color-accent)]/7 nav-link-active'
                : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text)] hover:bg-[var(--color-border)]/35'
            ]}
          >
            {page.label}
          </a>
        ))}
        <div class="ml-2 pl-2 border-l border-[var(--color-border)]">
          <ThemeToggle />
        </div>
      </div>

      <div class="flex items-center gap-2 md:hidden">
        <ThemeToggle />
        <button
          id="mobile-menu-btn"
          class="menu-button p-2 rounded-lg text-[var(--color-text-secondary)] hover:bg-[var(--color-border)]/35"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <div class="flex flex-col gap-1 border-t border-[var(--color-border)] pt-3">
        {pages.map(page => (
          <a
            href={page.path}
            class:list={[
              'nav-link px-3 py-2 rounded-lg text-sm',
              currentPath === page.path || (page.path !== '/' && currentPath.startsWith(page.path))
                ? 'text-[var(--color-accent)] bg-[var(--color-accent)]/7'
                : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text)] hover:bg-[var(--color-border)]/35'
            ]}
          >
            {page.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</nav>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const icon = document.getElementById('menu-icon');

    if (!btn || !menu || !icon) return;

    btn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!isOpen));
      icon.setAttribute('d', isOpen ? 'M4 7h16M4 12h16M4 17h16' : 'M6 18L18 6M6 6l12 12');
    });
  });
</script>

<style>
  .nav-brand {
    position: relative;
    transition: color var(--transition-base);
  }

  .nav-brand:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .nav-link,
  .menu-button {
    transition: color var(--transition-base), background-color var(--transition-base), border-color var(--transition-base), transform var(--transition-base);
  }

  .nav-link {
    border: 1px solid transparent;
  }

  .nav-link:hover,
  .menu-button:hover {
    transform: translateY(-1px);
  }

  .nav-link:hover {
    color: var(--color-text);
    border-color: color-mix(in srgb, var(--color-accent) 24%, transparent);
    background: color-mix(in srgb, var(--color-accent) 5%, var(--color-card-bg));
    box-shadow: var(--shadow-sm);
  }

  .menu-button:hover {
    color: var(--color-text);
    box-shadow: var(--shadow-sm);
  }
</style>
