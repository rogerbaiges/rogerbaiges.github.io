    <rect x="3.5" y="5.5" width="17" height="13" rx="1.75" stroke-width="1.7" />
    <path d="m4.5 7 7.5 5.8L19.5 7" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

