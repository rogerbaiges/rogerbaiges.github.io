---
import { diagramStages, type DiagramKind } from './data';

interface Props {
  kind: DiagramKind;
  caption?: string;
  class?: string;
}

const { kind, caption, class: className = '' } = Astro.props;
const stages = diagramStages[kind];
const accessibleLabel = stages.map((stage) => stage.join(', ')).join(' then ');
---

<figure
  class:list={['dl-diagram', `dl-diagram--${kind}`, className]}
  aria-label={accessibleLabel}
  data-dl-diagram
>
  <div class="dl-diagram__flow">
    {stages.map((stage, stageIndex) => (
      <>
        <div class="dl-diagram__stage">
          <div class="dl-diagram__nodes">
            {stage.map((node) => <span class="dl-diagram__node">{node}</span>)}
          </div>
        </div>
        {stageIndex < stages.length - 1 && (
          <span
            class="dl-diagram__connector"
            aria-hidden="true"
            style={`--dl-connector-index: ${stageIndex}`}
          >
            <svg viewBox="0 0 72 20" fill="none">
              <path d="M2 10H64" stroke="currentColor" stroke-width="1.5" />
              <polyline points="58,4 64,10 58,16" stroke="currentColor" stroke-width="1.5" fill="none" />
            </svg>
          </span>
        )}
      </>
    ))}
  </div>
  {caption && <figcaption class="dl-diagram__caption">{caption}</figcaption>}
</figure>
