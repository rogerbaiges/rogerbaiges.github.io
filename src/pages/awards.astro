---
import AwardRow from '@/components/site/AwardRow.astro';
import { awards } from '@/data/portfolio';
import SiteLayout from '@/layouts/SiteLayout.astro';
---

<SiteLayout
  title="Awards & Recognition"
  description="Hackathon wins, a Computer Vision Center research fellowship, and academic distinctions earned by Roger Baiges Trilla."
  canonicalPath="/awards/"
  bodyClass="awards-page"
>
  <header class="site-shell page-intro" data-reveal>
    <p class="eyebrow">Awards</p>
    <div class="page-intro__main">
      <h1>Awards &amp; Recognition</h1>
      <p class="page-intro__lede">
        Hackathon wins, research support, and academic distinctions, each kept attached to
        its verified scope.
      </p>
    </div>
  </header>

  <section class="site-shell awards-section" aria-label="Awards and recognition">
    <div class="award-list">
      {awards.map((item) => <AwardRow item={item} />)}
    </div>
  </section>
</SiteLayout>
