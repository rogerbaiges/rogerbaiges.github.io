---
import BaseLayout from '@components/layout/BaseLayout.astro';
import { getConfig } from '@lib/config';
import { loadResearchContent } from '@lib/content';

const config = getConfig();
if (!config.pages.research) return Astro.redirect('/404');

const research = loadResearchContent();
---

<BaseLayout title="Research" description="My research focuses on adaptation, forgetting, and recovery in foundation models, with current thesis work at CVC on OpenCLIP.">
  <div class="page-header animate-on-scroll">
    <h1 class="text-3xl">Research</h1>
    <p class="mt-3 max-w-3xl text-[var(--color-text-secondary)]">
      My current thesis at CVC, the questions it raises, and the broader direction I'm building toward.
    </p>
  </div>

  <section class="research-lead animate-on-scroll">
    <p class="research-kicker">Overview</p>
    <p class="research-overview">{research.overview}</p>
  </section>

  <section class="mt-8 animate-on-scroll">
    <article class="research-panel research-panel-main">
      <p class="research-kicker">Current Work</p>
      <h2 class="research-title">{research.current_project.title}</h2>
      <p class="research-org">{research.current_project.organization}</p>
      <p class="mt-4 text-[var(--color-text-secondary)]">{research.current_project.summary}</p>
      <p class="research-context">{research.current_project.thesis_note}</p>
    </article>
  </section>

  <div class="mt-6 grid gap-4 lg:grid-cols-3">
    <article class="research-panel animate-on-scroll">
      <p class="research-kicker">Questions</p>
      <ul class="research-list">
        {research.current_project.questions.map(question => (
          <li>{question}</li>
        ))}
      </ul>
    </article>

    <article class="research-panel animate-on-scroll">
      <p class="research-kicker">Methods</p>
      <ul class="research-list">
        {research.current_project.methods.map(method => (
          <li>{method}</li>
        ))}
      </ul>
    </article>

    {research.current_project.findings && research.current_project.findings.length > 0 && (
      <article class="research-panel animate-on-scroll">
        <p class="research-kicker">Early Evidence</p>
        <ul class="research-list">
          {research.current_project.findings.map(finding => (
            <li>{finding}</li>
          ))}
        </ul>
      </article>
    )}
  </div>

  <section class="mt-6 animate-on-scroll">
    <article class="research-panel">
      <p class="research-kicker">Broader Interests</p>
      <div class="interest-grid">
        {research.interests.map(interest => (
          <div class="interest-item">
            <h2 class="interest-title">{interest.title}</h2>
            <p class="interest-text">{interest.description}</p>
          </div>
        ))}
      </div>
      <div class="research-divider" aria-hidden="true"></div>
      <p class="research-kicker">Next Direction</p>
      <p class="research-forward">{research.future_direction}</p>
    </article>
  </section>
</BaseLayout>

<style>
  .research-lead,
  .research-panel {
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-card-bg) 98%, transparent);
    border-radius: 18px;
    padding: 1.2rem;
  }

  .research-lead {
    background:
      linear-gradient(135deg, rgba(36, 86, 211, 0.08), transparent 42%),
      color-mix(in srgb, var(--color-card-bg) 98%, transparent);
  }

  .research-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .research-overview {
    margin-top: 0.8rem;
    max-width: 46rem;
    font-size: 1rem;
    line-height: 1.68;
    color: var(--color-text);
  }

  .research-title {
    margin-top: 0.6rem;
    line-height: 1.08;
  }

  .research-org {
    margin-top: 0.35rem;
    font-size: 0.96rem;
    color: var(--color-accent);
  }

  .research-list {
    margin-top: 0.9rem;
    padding-left: 1.15rem;
    color: var(--color-text-secondary);
    display: grid;
    gap: 0.55rem;
  }

  .research-panel-main {
    padding-right: min(3rem, 4vw);
  }

  .research-context {
    margin-top: 0.95rem;
    max-width: 48rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .interest-grid {
    margin-top: 0.95rem;
    display: grid;
    gap: 0.9rem;
  }

  .interest-item {
    padding-top: 0.2rem;
  }

  .interest-title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .interest-text {
    margin-top: 0.35rem;
    color: var(--color-text-secondary);
  }

  .research-divider {
    margin: 1.2rem 0 1rem;
    border-top: 1px solid var(--color-border);
  }

  .research-forward {
    margin-top: 0.75rem;
    max-width: 46rem;
    color: var(--color-text-secondary);
    line-height: 1.68;
  }

  @media (min-width: 860px) {
    .interest-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }
</style>
