---
import { site } from '@/data/portfolio';
import SiteLayout from '@/layouts/SiteLayout.astro';
---

<SiteLayout
  title="CV"
  description="Preview and download Roger Baiges Trilla’s curriculum vitae."
  bodyClass="cv-page"
>
  <header class="site-shell page-intro page-intro--compact page-intro--cv" data-reveal>
    <p class="eyebrow">Curriculum vitae</p>
    <div class="page-intro__main">
      <h1>Roger Baiges Trilla — CV</h1>
      <p class="page-intro__lede">
        Research, engineering, education, projects, and recognition in one concise document.
      </p>
      <div class="page-intro__actions">
        <a class="button button--primary" href={site.cvPath} target="_blank" rel="noopener noreferrer">
          Open full screen <span aria-hidden="true">↗</span>
        </a>
        <a class="button button--secondary" href={site.cvPath} download="RogerBaigesCV.pdf">
          Download PDF <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </header>

  <section class="site-shell cv-preview-section" aria-label="CV document preview" data-reveal>
    <div class="cv-preview">
      <object
        data={`${site.cvPath}#page=1&view=FitH`}
        type="application/pdf"
        title="Roger Baiges Trilla curriculum vitae"
      >
        <div class="cv-preview__fallback">
          <p>Your browser cannot display the PDF preview.</p>
          <a href={site.cvPath} target="_blank" rel="noopener noreferrer">Open the CV in a new tab</a>
        </div>
      </object>
    </div>

    <div class="cv-mobile-fallback">
      <span class="cv-mobile-fallback__icon" aria-hidden="true">PDF</span>
      <div>
        <h2>Roger Baiges Trilla — Curriculum Vitae</h2>
        <p>Use the buttons above to open the full document in your device’s PDF viewer or download a copy.</p>
      </div>
    </div>
  </section>
</SiteLayout>
