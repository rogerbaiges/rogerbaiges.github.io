---
import { Picture } from 'astro:assets';
import portrait from '@/assets/portfolio/roger-baiges.jpg';
import EvidenceStrip from '@/components/site/EvidenceStrip.astro';
import OrganizationMark from '@/components/site/OrganizationMark.astro';
import SectionHeading from '@/components/site/SectionHeading.astro';
import Trajectory from '@/components/site/Trajectory.astro';
import { awards, experience, hero, projects } from '@/data/portfolio';
import SiteLayout from '@/layouts/SiteLayout.astro';

const featuredProjects = projects.filter((project) => project.featuredOnHome);
const featuredAwards = awards.filter((award) => award.featuredOnHome);
---

<SiteLayout>
  <section class="home-hero" aria-labelledby="home-heading">
    <div class="site-shell home-hero__grid">
      <div class="home-hero__copy" data-reveal>
        <p class="eyebrow">{hero.role}</p>
        <h1 id="home-heading">{hero.heading}</h1>
        <p class="home-hero__introduction">{hero.introduction}</p>
        <p class="home-hero__trajectory">{hero.trajectory}</p>

        <div class="home-hero__actions">
          <a class="button button--primary" href={hero.primaryAction.href}>
            {hero.primaryAction.label}<span aria-hidden="true">→</span>
          </a>
          <a class="button button--secondary" href={hero.secondaryAction.href}>
            {hero.secondaryAction.label}<span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <figure class="home-hero__portrait" data-reveal style="--reveal-order:1">
        <div class="portrait-frame">
          <Picture
            src={portrait}
            formats={['avif', 'webp']}
            widths={[180, 240, 360, 480, 600]}
            sizes="(max-width: 560px) 200px, (max-width: 800px) 228px, 240px"
            alt="Portrait of Roger Baiges Trilla"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
        <figcaption>Roger Baiges Trilla</figcaption>
      </figure>
    </div>
  </section>

  <EvidenceStrip />

  <section class="site-shell home-section" aria-labelledby="experience-preview-heading">
    <SectionHeading
      id="experience-preview-heading"
      eyebrow="Research & industry"
      title="Experience"
      description="Current research at EPFL, earlier foundation-model work at CVC, and private AI systems built at Serimag."
      action={{ label: 'All experience', href: '/experience/' }}
    />
    <div class="experience-preview-grid">
      {experience.map((entry, index) => (
        <article
          class:list={[
            'experience-preview',
            `experience-preview--${entry.id}`,
          ]}
          data-reveal
          style={`--reveal-order:${index}`}
        >
          <header class="experience-preview__header">
            <div>
              <p class="eyebrow">{entry.kind}</p>
              <p class="experience-preview__period">{entry.period}</p>
            </div>
            <OrganizationMark organization={entry.organization} linked compact />
          </header>
          <h3>{entry.role}</h3>
          <p class="experience-preview__organization">{entry.organizationLine}</p>
          <div class="experience-preview__body">
            <p class="experience-preview__summary">{entry.preview}</p>
            <p class="evidence-callout">{entry.evidence}</p>
          </div>
          <a class="card-link" href={`/experience/#${entry.id}`}>
            Explore this experience <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="site-shell home-section" aria-labelledby="trajectory-heading">
    <SectionHeading
      id="trajectory-heading"
      eyebrow="Education & trajectory"
      title="A path built across research and engineering."
      action={{ label: 'Experience & education', href: '/experience/' }}
    />
    <Trajectory />
  </section>

  <section class="site-shell home-section" aria-labelledby="projects-heading">
    <SectionHeading
      id="projects-heading"
      eyebrow="Independent systems"
      title="Selected projects"
      description="Compact, working explorations across multimodal AI, language models, and public-service tools."
      action={{ label: 'All projects', href: '/projects/' }}
    />
    <div class="project-preview-grid">
      {featuredProjects.map((project, index) => (
        <a
          class="project-preview"
          href={`/projects/#${project.slug}`}
          data-reveal
          style={`--reveal-order:${index}`}
        >
          <p class="project-preview__meta">{project.year} · {project.context}</p>
          <h3>{project.name}</h3>
          <p>{project.description}</p>
          <strong>{project.outcome}</strong>
          <ul class="tag-list" aria-label={`${project.name} technologies`}>
            {project.technologies.slice(0, 3).map((technology) => <li>{technology}</li>)}
          </ul>
          <span class="card-link">View project <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="site-shell home-section home-section--last" aria-labelledby="awards-heading">
    <SectionHeading
      id="awards-heading"
      eyebrow="Selected recognition"
      title="Selected awards"
      action={{ label: 'All awards', href: '/awards/' }}
    />
    <div class="award-preview-list">
      {featuredAwards.map((award, index) => (
        <a
          class="award-preview"
          href="/awards/"
          data-reveal
          style={`--reveal-order:${index}`}
        >
          {award.organization && (
            <span class="award-preview__mark" aria-hidden="true">
              <OrganizationMark organization={award.organization} compact eager={index < 2} />
            </span>
          )}
          <span class="award-preview__copy">
            <span class="award-preview__year">{award.year}</span>
            <strong>{award.title}</strong>
            <small>{award.organizer}</small>
            {award.homeProof && <span class="award-preview__proof">{award.homeProof}</span>}
          </span>
          <span aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>
