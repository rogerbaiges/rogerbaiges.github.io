---
import SiteLayout from '@/layouts/SiteLayout.astro';
---

<SiteLayout
  title="Page not found"
  description="The requested page could not be found."
  canonicalPath="/404.html"
  noindex
>
  <section class="site-shell not-found" aria-labelledby="not-found-heading">
    <div class="not-found__inner" data-reveal>
      <p class="not-found__code">404</p>
      <h1 id="not-found-heading">This page has moved or never existed.</h1>
      <p>Return home or continue through Roger’s selected projects.</p>
      <div class="not-found__actions">
        <a class="button button--primary" href="/">Back home <span aria-hidden="true">→</span></a>
        <a class="button button--secondary" href="/projects/">Explore projects <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</SiteLayout>
