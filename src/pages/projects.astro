---
import ProjectCard from '@/components/site/ProjectCard.astro';
import { projects } from '@/data/portfolio';
import SiteLayout from '@/layouts/SiteLayout.astro';
---

<SiteLayout
  title="Projects"
  description="Independent and team-built AI projects by Roger Baiges Trilla across language models, multimodal systems, public services, forecasting, and recommendation."
  canonicalPath="/projects/"
  bodyClass="projects-page"
>
  <header class="site-shell page-intro" data-reveal>
    <p class="eyebrow">Independent work</p>
    <div class="page-intro__main">
      <h1>Projects</h1>
      <p class="page-intro__lede">
        Six independent and team-built systems spanning language models, multimodal agents,
        public services, forecasting, and recommendation.
      </p>
    </div>
  </header>

  <section class="site-shell projects-section" aria-label="Selected projects">
    <div class="project-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</SiteLayout>
