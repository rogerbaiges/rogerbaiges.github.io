---
import { Picture } from 'astro:assets';
import portrait from '@/assets/portfolio/roger-baiges.jpg';
import ContactIcon from '@/components/site/ContactIcon.astro';
import { about, contacts } from '@/data/portfolio';
import SiteLayout from '@/layouts/SiteLayout.astro';
---

<SiteLayout
  title="About"
  description="About Roger Baiges Trilla, an AI researcher and engineer drawn to ambitious research, R&D, and technically differentiated AI systems."
>
  <header class="site-shell page-intro page-intro--centered" data-reveal>
    <p class="eyebrow">About</p>
    <h1>About Roger</h1>
  </header>

  <section class="site-shell about-story" aria-label="About Roger Baiges Trilla">
    <figure class="about-story__portrait" data-reveal>
      <div class="portrait-frame">
        <Picture
          src={portrait}
          formats={['avif', 'webp']}
          widths={[180, 240, 360, 480, 600]}
          sizes="(max-width: 720px) 200px, 232px"
          alt="Portrait of Roger Baiges Trilla"
          loading="eager"
          decoding="async"
        />
      </div>
      <figcaption>Roger Baiges Trilla</figcaption>
    </figure>

    <div class="about-story__body" data-reveal style="--reveal-order:1">
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="site-shell contact-section" id="contact" aria-labelledby="contact-heading">
    <header class="contact-section__intro" data-reveal>
      <p class="eyebrow">Contact</p>
      <h2 id="contact-heading">{about.contactHeading}</h2>
      <p>{about.contactText}</p>
    </header>

    <div class="contact-grid">
      {contacts.map((item, index) => (
        <a
          class="contact-row"
          href={item.href}
          target={item.href.startsWith('http') ? '_blank' : undefined}
          rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          data-reveal
          style={`--reveal-order:${index}`}
        >
          <ContactIcon src={item.icon} />
          <span class="contact-row__copy">
            <strong>{item.label}</strong>
            <span>{item.display}</span>
          </span>
          <span class="contact-row__arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>
