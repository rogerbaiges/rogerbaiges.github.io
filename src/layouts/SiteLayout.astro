---
import SiteHeader from '@/components/site/SiteHeader.astro';
import SiteFooter from '@/components/site/SiteFooter.astro';
import { contacts, organizations, site } from '@/data/portfolio';
import '@/styles/site.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title,
  description = site.description,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  bodyClass = '',
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonicalUrl = new URL(canonicalPath, site.url).href;
const ogImageUrl = new URL(site.ogImage, site.url).href;
const currentPath = Astro.url.pathname;

const personSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#roger-baiges-trilla`,
      name: site.name,
      url: site.url,
      image: new URL(site.portrait, site.url).href,
      email: `mailto:${site.email}`,
      jobTitle: site.role,
      description: site.description,
      affiliation: [
        { '@type': 'CollegeOrUniversity', name: organizations.epfl.name, url: organizations.epfl.url },
        { '@type': 'Organization', name: organizations.lts4.name, url: organizations.lts4.url },
      ],
      alumniOf: [
        { '@type': 'CollegeOrUniversity', name: organizations.upc.name, url: organizations.upc.url },
        { '@type': 'CollegeOrUniversity', name: organizations.kuleuven.name, url: organizations.kuleuven.url },
      ],
      sameAs: contacts.filter((item) => item.href.startsWith('http')).map((item) => item.href),
      knowsAbout: [
        'Foundation models',
        'Language models',
        'Vision-language models',
        'Multimodal systems',
        'Private AI',
        'Agentic workflows',
        'Document AI',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      name: site.name,
      url: site.url,
      description: site.description,
      inLanguage: site.language,
    },
    {
      '@type': 'ItemList',
      name: 'Primary navigation',
      itemListElement: site.navigation.map((item, index) => ({
        '@type': 'SiteNavigationElement',
        position: index + 1,
        name: item.label,
        url: new URL(item.href, site.url).href,
      })),
    },
  ],
};
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#f7f8fa" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:locale" content={site.locale} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.role}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${site.name} — ${site.role}`} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <slot name="head" />
    <script is:inline>document.documentElement.classList.add('has-js');</script>
    <script is:inline>
      (function () {
        var storageKey = 'portfolio:navigation-scroll-target';

        function resetRequestedNavigationScroll() {
          var target = null;
          try {
            target = sessionStorage.getItem(storageKey);
          } catch (error) {
            return;
          }

          if (target !== location.pathname + location.search || location.hash) return;
          sessionStorage.removeItem(storageKey);

          var root = document.documentElement;
          var previousBehavior = root.style.scrollBehavior;
          var canControlRestoration = 'scrollRestoration' in history;
          var previousRestoration = canControlRestoration ? history.scrollRestoration : 'auto';

          if (canControlRestoration) history.scrollRestoration = 'manual';
          root.style.scrollBehavior = 'auto';
          window.scrollTo(0, 0);

          requestAnimationFrame(function () {
            window.scrollTo(0, 0);
            requestAnimationFrame(function () {
              root.style.scrollBehavior = previousBehavior;
              if (canControlRestoration) history.scrollRestoration = previousRestoration;
            });
          });
        }

        window.addEventListener('pageshow', resetRequestedNavigationScroll);
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', resetRequestedNavigationScroll, { once: true });
        } else {
          resetRequestedNavigationScroll();
        }
      })();
    </script>
  </head>
  <body class={bodyClass} id="top">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />

    <script is:inline>
      (function () {
        function initReveals() {
          var items = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!items.length || reduce || !('IntersectionObserver' in window)) {
            items.forEach(function (item) { item.classList.add('is-visible'); });
            return;
          }
          try {
            var observer = new IntersectionObserver(function (entries, instance) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('is-visible');
                instance.unobserve(entry.target);
              });
            }, { rootMargin: '0px 0px -6% 0px', threshold: 0.05 });
            document.documentElement.classList.add('reveal-ready');
            items.forEach(function (item) { observer.observe(item); });
          } catch (error) {
            document.documentElement.classList.remove('reveal-ready');
            items.forEach(function (item) { item.classList.add('is-visible'); });
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initReveals, { once: true });
        } else {
          initReveals();
        }
      })();
    </script>
  </body>
</html>
